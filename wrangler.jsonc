{
  "name": "kairo",
  "workers_dev": true,
  "dev": {
    "port": 8787
  },
  "routes": [],
  "main": "serverless/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CONTRACT_ADDRESS": "0xC99296d7C8D50F1c0DB7234c6338ea50805e6121",
    "MAX_FEE_GWEI": "10",
    "SITE_ORIGIN": "https://kairo.aakritigupta7227.workers.dev",
    "ISSUER_ADDRESS": "0x8C60aF4B93d1e4c14C473F5B9Ffc488cfa2c4E7C",
    "CHAIN_ID": "11155111",
    "CHAIN_NAME": "Sepolia",
    "PUBLIC_RPC_URL": "https://ethereum-sepolia-rpc.publicnode.com",
    "EXPLORER_URL": "https://sepolia.etherscan.io",
    "EVENTS_PER_WALLET_PER_DAY": "5",
    "EMAIL_RETENTION_DAYS": "30",
    "MEDIA_BASE_URL": "https://kairo.aakritigupta7227.workers.dev/media/",
    "ARCHIVE_CONTRACT_ADDRESSES": "[\"0x999524Cb77Db83864DA6FAC42614387921933922\",\"0x90a2920272dd3852193A79DA621B1Ccc9D093714\"]"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kairo",
      "database_id": "3bb094ae-f896-4aee-b83d-c89b6ec0f7b0",
      "migrations_dir": "serverless/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "kairo-media",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MINT",
        "class_name": "MintCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MintCoordinator"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "preview_urls": false
}
