{
  "name": "kairo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "forge test && node --test serverless/*.test.js frontend/*.test.js scripts/smoke-local.test.js scripts/deploy.test.js",
    "test:contracts": "forge test",
    "start": "npm run dev",
    "build": "node scripts/build-frontend.js",
    "dev": "npm run build && npm run db:local && wrangler dev",
    "db:local": "wrangler d1 migrations apply kairo --local",
    "db:remote": "wrangler d1 migrations apply kairo --remote",
    "deploy:app": "npm run build && npm run db:remote && wrangler deploy",
    "test:workflow": "forge build && node scripts/verify-workflow.js",
    "preflight:app": "node scripts/preflight-app.js",
    "secrets:app": "node scripts/upload-runtime-secrets.js",
    "deploy:sepolia": "node --env-file=.env scripts/deploy.js",
    "deploy:pages": "npm run build && node scripts/deploy-pages.js",
    "smoke:local": "node scripts/smoke-local.js",
    "verify:sepolia": "node scripts/verify-sepolia.js",
    "verify:media": "node scripts/verify-media.js",
    "verify:local": "node scripts/verify-local-app.js"
  },
  "dependencies": {
    "@metamask/connect-evm": "^2.1.1",
    "@openzeppelin/contracts": "^5.0.2",
    "ethers": "6.17.0",
    "qrcode": "1.5.4",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "linkedom": "^0.18.14",
    "wrangler": "4.149.0"
  }
}
